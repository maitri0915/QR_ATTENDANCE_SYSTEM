# Copy this file to ".env" and edit. Everything is optional except the admin login.

# ---- Branding (shown across the site) ----
APP_NAME=AttendEase
# Only used to name the university created when an old single-university database is migrated.
COLLEGE_NAME=Your College Name
SUPPORT_EMAIL=

# ---- Platform super admin (the platform owner; used once by `python init_db.py`) ----
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_EMAIL=owner@example.com
PLATFORM_ADMIN_PASSWORD=choose-a-strong-password

# ---- Security (set these for a real deployment) ----
# A long random string. If empty, one is generated and stored in data/secret_key.
SESSION_SECRET_KEY=
# Set to 1 when the site is served over HTTPS (required for camera + GPS on phones).
COOKIE_HTTPS_ONLY=0

# ---- Storage ----
# DATA_DIR=./data
# DATABASE_PATH=./data/attendance.db

# TENANT_DIR=./data/tenants
# PLATFORM_DATABASE_PATH=./data/platform.db
