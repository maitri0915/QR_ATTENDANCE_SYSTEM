# Copy this file to ".env" and edit. Everything is optional except the admin login.

# ---- Branding (shown across the site) ----
APP_NAME=AttendEase
COLLEGE_NAME=Your College Name
SUPPORT_EMAIL=

# ---- First administrator (used once by `python init_db.py`) ----
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@yourcollege.edu
ADMIN_PASSWORD=choose-a-strong-password

# ---- Security (set these for a real deployment) ----
# A long random string. If empty, one is generated and stored in data/secret_key.
SESSION_SECRET_KEY=
# Set to 1 when the site is served over HTTPS (required for camera + GPS on phones).
COOKIE_HTTPS_ONLY=0

# ---- Storage ----
# DATA_DIR=./data
# DATABASE_PATH=./data/attendance.db
